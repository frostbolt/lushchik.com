---
layout: layouts/base.njk
---

<nav class="post-nav">
	<a href="/" class="back-link">← Back</a>
</nav>

<article class="post">
	<header class="post-header">
		<h1>{{ title }}</h1>
		<p class="post-meta">{{ date | displayDate }}</p>
	</header>
	<div class="post-content">
		{{ content | safe }}
	</div>
</article>

<style>
	.post-nav {
		margin-bottom: 2rem;
	}

	.back-link {
		font-size: 0.9rem;
		color: var(--muted);
		text-decoration: none;
		transition: color 0.15s;
	}

	.back-link:hover {
		color: var(--text);
	}

	.post {
		max-width: 700px;
	}

	.post-header {
		margin-bottom: 2rem;
	}

	.post h1 {
		font-size: 1.75rem;
		font-weight: 800;
		letter-spacing: -0.035em;
		line-height: 1.2;
		margin-bottom: 0.5rem;
	}

	.post-meta {
		color: var(--muted);
		font-size: 0.9rem;
	}

	.post-content h2 {
		margin-top: 2.25rem;
		margin-bottom: 0.75rem;
		font-size: 1.25rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		text-transform: none;
		color: var(--text);
		padding: 0;
		border: none;
		border-left: none;
	}

	.post-content h3 {
		margin-top: 1.5rem;
		margin-bottom: 0.5rem;
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	.post-content p {
		margin-bottom: 1rem;
	}

	.post-content p:last-of-type {
		margin-top: 2.5rem;
	}

	.post-content ul,
	.post-content ol {
		margin-left: 1.5rem;
		margin-bottom: 1.25rem;
	}

	.post-content ul {
		list-style: none;
		padding-left: 0;
	}

	.post-content ul li {
		margin-bottom: 0.75rem;
		line-height: 1.6;
		padding-left: 1.5rem;
		position: relative;
	}

	.post-content ul li::before {
		content: "☞";
		position: absolute;
		left: 0;
		color: var(--muted);
	}

	.post-content ol li {
		margin-bottom: 0.75rem;
		line-height: 1.6;
	}

	.post-content code {
		background: color-mix(in srgb, var(--muted) 14%, transparent);
		color: var(--text);
		padding: 0.15rem 0.4rem;
		border-radius: 3px;
		font-size: 0.88em;
		font-family: var(--f-mono);
		font-weight: 500;
	}

	.post-content a {
		text-decoration: underline;
	}

	.post-content img {
		display: block;
		max-width: 100%;
		height: auto;
		margin: 1.75rem auto;
		border-radius: 6px;
	}
</style>
